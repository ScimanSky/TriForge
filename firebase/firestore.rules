rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      // Athlete profile, account and current consents. Deleting the account
      // goes through the server, which also removes what the app cannot
      // reach (Garmin tokens) and the login.
      allow read, create, update: if isOwner(uid);
      allow delete: if false;

      // Activities. The Garmin service writes its own with admin rights,
      // which bypass these rules. The app may only write what it imported
      // from Health Connect, and may never forge or alter a Garmin activity.
      match /activities/{activityId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.source == 'health_connect';
        allow update: if isOwner(uid)
          && resource.data.source == 'health_connect'
          && request.resource.data.source == 'health_connect';
        allow delete: if isOwner(uid)
          && resource.data.source == 'health_connect';
      }

      // Daily recovery data (HRV, resting HR, sleep). Same rule as
      // activities: the Garmin service writes its own, the app only what it
      // imported from Health Connect.
      match /wellness/{dayId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.source == 'health_connect';
        allow update: if isOwner(uid)
          && resource.data.source == 'health_connect'
          && request.resource.data.source == 'health_connect';
        allow delete: if isOwner(uid)
          && resource.data.source == 'health_connect';
      }

      // Morning check-in, one per day, keyed by date. Items are 1 to 7.
      match /checkIns/{day} {
        function item(name) {
          return request.resource.data[name] is int
            && request.resource.data[name] >= 1
            && request.resource.data[name] <= 7;
        }
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.date == day
          && request.resource.data.keys().hasOnly(
            ['date', 'sleepQuality', 'fatigue', 'soreness', 'stress', 'motivation', 'sick'])
          && item('sleepQuality') && item('fatigue') && item('soreness')
          && item('stress') && item('motivation')
          && request.resource.data.sick is bool;
      }

      // Consent history: one entry per answer, never changed or removed by
      // the app, so TriForge can show what the athlete agreed to and when
      // (art. 7(1) GDPR). The server erases it with the account.
      match /consentLog/{entryId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['type', 'granted', 'version', 'at'])
          && request.resource.data.type in ['terms', 'health', 'aiCoach']
          && request.resource.data.granted is bool
          && request.resource.data.version is string
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }

      // Profile photo: one small JPEG, cropped and compressed on the phone.
      match /media/{name} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && name == 'avatar'
          && request.resource.data.keys().hasOnly(['jpeg', 'updatedAt'])
          && request.resource.data.jpeg is bytes
          && request.resource.data.jpeg.size() <= 262144;
      }

      // Connection status of external sources. Written only by the server.
      match /integrations/{provider} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Encrypted Garmin tokens and MFA state. Server only.
      match /private/{document=**} {
        allow read, write: if false;
      }
    }
  }
}
